# Build output and CMake cache -- regenerate with cmake --preset + ninja.
/out/
/build/


# Session/runtime state written by the SDK at run time (logs, caches, user
# profile data) -- never source, always local to a machine/run.
/_state_cache/
/_state_logs/
/_state_user/
/cache/
/cache0/
/cache1/
/content/
/user/

# scripts/play.sh and scripts/test-run.sh data (saves, settings, logs).
/play/
/testrun/

# Backup files left by manual edits during debugging sessions.
*.bak
*.bak_*

# IDE/editor
.vs/
.vscode/
*.user

# Never the retail game itself -- this repo is the recompilation project,
# not a game data distribution.
*.xex
*.xbe
*.iso
*.xiso
# Recompiled code is generated locally from your own game files and must never
# be committed. rexglue.cmake is build boilerplate (no game data) that the
# top-level CMakeLists.txt includes before codegen has run.
/generated/*
!/generated/rexglue.cmake
